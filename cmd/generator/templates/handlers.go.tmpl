package server

import (
	"net/http"
	"time"

	"[[.Module]]/internal/events"
	"[[.Module]]/internal/store"
)

// [[.TitlePlural]] — generated by `generator entity [[.Singular]]`.
//
// One file per domain: list / create / get / update / delete plus a live
// event on every mutation. There is no ownership check and no auth gate —
// DockerPull is a single-user local tool (AGENTS.md convention 2).
//
// Reference implementations for the surrounding conventions:
// internal/server/handlers_settings.go (simple envelope) and
// internal/server/handlers_tasks.go (lifecycle + events).

// [[.TitleCamelLower]]DTO is the wire shape (mirrors web/src/lib/api/[[.Plural]].ts).
type [[.TitleCamelLower]]DTO struct {
	ID        string    `json:"id"`
[[range .Fields]]	[[.GoName]] [[.GoType]] `json:"[[.JSONName]]"`
[[end]]	CreatedAt time.Time `json:"createdAt"`
	UpdatedAt time.Time `json:"updatedAt"`
}

func to[[.TitleCamel]]DTO(r *store.[[.TitleCamel]]) [[.TitleCamelLower]]DTO {
	return [[.TitleCamelLower]]DTO{
		ID: r.ID,
[[range $f := .Fields]]		[[$f.GoName]]: r.[[$f.GoName]],
[[end]]		CreatedAt: r.CreatedAt, UpdatedAt: r.UpdatedAt,
	}
}

func (s *Server) handleList[[.TitleCamel]](w http.ResponseWriter, r *http.Request) {
	rows, err := s.store.List[[.TitleCamel]](r.Context())
	if err != nil {
		storeError(w, err)
		return
	}
	out := make([][[.TitleCamelLower]]DTO, 0, len(rows))
	for i := range rows {
		out = append(out, to[[.TitleCamel]]DTO(&rows[i]))
	}
	writeOK(w, map[string]any{"[[.Plural]]": out})
}

func (s *Server) handleCreate[[.TitleCamel]](w http.ResponseWriter, r *http.Request) {
	var req struct {
[[range $f := .Fields]]		[[$f.GoName]] [[.GoType]] `json:"[[$f.JSONName]]"`
[[end]]	}
	if !readJSON(w, r, &req) {
		return
	}
	id, err := randomID("[[.Singular]]_")
	if err != nil {
		storeError(w, err)
		return
	}
	row := &store.[[.TitleCamel]]{
		ID: id,
[[range $f := .Fields]]		[[$f.GoName]]: req.[[$f.GoName]],
[[end]]	}
	if err := s.store.Create[[.TitleCamel]](r.Context(), row); err != nil {
		if isDuplicate(err) {
			writeError(w, http.StatusConflict, "已存在相同的记录")
			return
		}
		storeError(w, err)
		return
	}
	s.hub.Publish(events.Event{Type: "[[.Singular]].created", Data: to[[.TitleCamel]]DTO(row)})
	writeJSON(w, http.StatusCreated, map[string]any{"ok": true, "[[.Singular]]": to[[.TitleCamel]]DTO(row)})
}

// load[[.TitleCamel]] fetches the row named by the {id} path value. A
// missing row is a 404 via storeError.
func (s *Server) load[[.TitleCamel]](w http.ResponseWriter, r *http.Request) (*store.[[.TitleCamel]], bool) {
	row, err := s.store.Get[[.TitleCamel]](r.Context(), r.PathValue("id"))
	if err != nil {
		storeError(w, err)
		return nil, false
	}
	return row, true
}

func (s *Server) handleGet[[.TitleCamel]](w http.ResponseWriter, r *http.Request) {
	row, ok := s.load[[.TitleCamel]](w, r)
	if !ok {
		return
	}
	writeOK(w, map[string]any{"[[.Singular]]": to[[.TitleCamel]]DTO(row)})
}

func (s *Server) handleUpdate[[.TitleCamel]](w http.ResponseWriter, r *http.Request) {
	row, ok := s.load[[.TitleCamel]](w, r)
	if !ok {
		return
	}
	// Pointers distinguish "field omitted" from "field set to zero".
	var req struct {
[[range $f := .Fields]]		[[$f.GoName]] *[[$f.GoType]] `json:"[[$f.JSONName]]"`
[[end]]	}
	if !readJSON(w, r, &req) {
		return
	}
[[range $f := .Fields]]	if req.[[$f.GoName]] != nil {
		row.[[$f.GoName]] = *req.[[$f.GoName]]
	}
[[end]]	if err := s.store.Update[[.TitleCamel]](r.Context(), row); err != nil {
		storeError(w, err)
		return
	}
	s.hub.Publish(events.Event{Type: "[[.Singular]].updated", Data: to[[.TitleCamel]]DTO(row)})
	writeOK(w, map[string]any{"[[.Singular]]": to[[.TitleCamel]]DTO(row)})
}

func (s *Server) handleDelete[[.TitleCamel]](w http.ResponseWriter, r *http.Request) {
	row, ok := s.load[[.TitleCamel]](w, r)
	if !ok {
		return
	}
	if err := s.store.Delete[[.TitleCamel]](r.Context(), row.ID); err != nil {
		storeError(w, err)
		return
	}
	s.hub.Publish(events.Event{Type: "[[.Singular]].deleted", Data: to[[.TitleCamel]]DTO(row)})
	writeOK(w, map[string]any{"id": row.ID})
}
