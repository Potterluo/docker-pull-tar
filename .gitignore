# Build artifacts
bin/
# Only the ROOT dist/. A bare `dist/` also matches internal/server/dist, which
# excluded the directory itself — and an excluded directory cannot be
# re-included, so `internal/server/dist/.gitkeep` could never be committed. A
# fresh clone then had NO dist directory at all and `go:embed all:dist` failed
# with "pattern all:dist: no matching files found" (the release job got away
# with it only because it builds the frontend into that directory first).
/dist/
web/out/
web/.next/
internal/server/dist/*
!internal/server/dist/.gitkeep

# Wails build output (icons/appicon stay tracked)
build/bin/

# Runtime data
data/
*.db
*.db-wal
*.db-shm

# Smoke-test scratch (scripts/smoke.ps1 keeps its throwaway data dir in the
# repo on purpose: a restricted or sandboxed environment may deny a child
# process writes under %TEMP%). Its captured output lands next to it, and an
# ad-hoc verification run leaves similar dot-dirs behind — none of it belongs
# in a commit.
.smoke-data/
.sm.txt
.sm.e.txt
.t[0-9]*/
.g[0-9]*/
.s[0-9]*/
.r[0-9]*/
.hw[0-9]*/
# Screenshot scratch: scripts/screenshots.ps1 runs against a REAL data directory
# (tasks, artifacts, credentials), so it holds downloaded blobs and tars. Only
# the PNGs next to it belong in the repo.
docs/screenshots/.data/

# Local build output / downloaded images
downloads/
*.tar

# Legacy Python implementation's own artifacts (archived under legacy/)
legacy/**/__pycache__/
legacy/.pytest_cache/
legacy/downloads/

# Dependencies
node_modules/

# Environment — never commit real secrets (.env.example is the template)
.env*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.shots/
