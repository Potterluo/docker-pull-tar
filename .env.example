# DockerPull bootstrap configuration.
#
# Copy to .env and adjust. Real environment variables ALWAYS win over this
# file, so container/shell overrides keep working. NEVER commit your real
# .env (it is gitignored).
#
# These are process/bootstrap settings only. Everything user-facing — the
# download options, output directory, proxy and data sources — lives in the
# database and is edited from the GUI's /settings page or by the CLI (which
# reads the same rows). See README.md §配置说明.

# --- HTTP server ---
# APP_PORT=8080
# APP_BIND=loopback          # loopback | all
# APP_RATE_LIMIT_RPM=0       # requests/minute per client IP on /api/*; 0 = unlimited
# APP_LOG_LEVEL=info         # debug | info | warn | error

# --- Storage ---
# APP_DATA_DIR=./data        # SQLite database + default download directory
# APP_DB_TYPE=sqlite         # sqlite | postgres
# APP_DB_DSN=                # postgres DSN, or an explicit sqlite path
# APP_DB_AUTO_MIGRATE=true

# --- Development ---
# APP_DEV_PROXY=http://localhost:3000   # proxy UI to `next dev` (HMR)
